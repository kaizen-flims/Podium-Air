# Chromium extension id. Development builds pin it with the manifest `key`
# (see web/extension/wxt.config.ts), so this value matches every unpacked
# install. A Chrome Web Store build gets its own id; set it here for that build.
VITE_EXTENSION_ID_CHROMIUM=

# Where the Android app banner points on mobile browsers.
VITE_ANDROID_APP_URL=https://github.com/kaizen-flims/Podium-Air/releases/latest

# Public Google OAuth Web client id (never a client secret).
# Authorized JS origin for Pages: https://kaizen-flims.github.io
# Optional YouTube playlists need YouTube Data API v3 enabled in the same project.
VITE_GOOGLE_CLIENT_ID=
