{
  "name": "@bitchord/extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox && wxt build -b safari",
    "zip": "wxt zip && wxt zip -b firefox && wxt zip -b safari",
    "typecheck": "tsc -p . && tsc -p tsconfig.node.json",
    "dev-key": "node scripts/gen-dev-key.mjs",
    "postinstall": "wxt prepare",
    "package": "pnpm build && node scripts/publish-to-site.mjs && node scripts/check-safari.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "build:safari": "wxt build -b safari"
  },
  "dependencies": {
    "@bitchord/shared": "workspace:*"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "fflate": "0.8.3",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  },
  "version": "0.4.5"
}
